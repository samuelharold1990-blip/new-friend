{
  "_meta_note": "Character-consistent selfie workflow. Requires the ComfyUI_IPAdapter_plus custom nodes (with InsightFace) and the FaceID Plus V2 models installed. The app falls back to comfy_workflow.json automatically if ComfyUI rejects this graph. You can replace this file with your own API-format workflow export; keep the {{PROMPT}}/{{NEGATIVE}}/{{CHECKPOINT}}/{{SEED}}/{{WIDTH}}/{{HEIGHT}}/{{REFERENCE}} placeholders.",
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": {{SEED}},
      "steps": 28,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["11", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "{{CHECKPOINT}}" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": {{WIDTH}}, "height": {{HEIGHT}}, "batch_size": 1 }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{PROMPT}}", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE}}", "clip": ["4", 1] }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "companion", "images": ["8", 0] }
  },
  "10": {
    "class_type": "IPAdapterUnifiedLoaderFaceID",
    "inputs": {
      "model": ["4", 0],
      "preset": "FACEID PLUS V2",
      "lora_strength": 0.6,
      "provider": "CPU"
    }
  },
  "11": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["10", 0],
      "ipadapter": ["10", 1],
      "image": ["12", 0],
      "weight": 0.85,
      "weight_faceidv2": 1.0,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "12": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{REFERENCE}}" }
  }
}
